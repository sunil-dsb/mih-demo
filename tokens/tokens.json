   "blue-900": "#00226C",
   "blue-950": "#00144A",
   "ink-50": "#F2F4F7",
   "ink-100": "#E6E9EE",
   "ink-200": "#D2D7E0",
   "ink-300": "#BBC1CF",
   "ink-400": "#979DAA",
   "ink-500": "#6F7582",
   "ink-600": "#5E646F",
   "ink-700": "#4E5460",
   "ink-800": "#3A404A",
   "ink-900": "#242A34",
   "ink-950": "#151923",
   "green-50": "#EBF8EC",
   "green-100": "#D5EFDA",
   "green-200": "#B4E2BC",
   "green-300": "#8FD09C",
   "green-400": "#2DB45B",
   "green-500": "#02883D",
   "green-600": "#047333",
   "green-700": "#02612A",
   "green-800": "#014A1E",
   "green-900": "#013112",
   "green-950": "#001F09",
   "red-50": "#FEF2F0",
   "red-100": "#FEE3DF",
   "red-200": "#FECAC4",
   "red-300": "#FEACA3",
   "red-400": "#FF7165",
   "red-500": "#DE302E",
   "red-600": "#C70B18",
   "red-700": "#AC0110",
   "red-800": "#84030B",
   "red-900": "#5B0105",
   "red-950": "#3D0002",
   "amber-50": "#FEF2E7",
   "amber-100": "#FEE4CF",
   "amber-200": "#FACFA9",
   "amber-300": "#F1B57E",
   "amber-400": "#FF9500",
   "amber-500": "#AD6303",
   "amber-600": "#935400",
   "amber-700": "#7D4703",
   "amber-800": "#603502",
   "amber-900": "#412200",
   "amber-950": "#2B1400"
  },
  "semantic": {
   "bg-page": "{white}",
   "bg-card": "{ink-50}",
   "bg-card-pressed": "{ink-100}",
   "bg-input": "{white}",
   "bg-selected": "{blue-50}",
   "bg-inverse": "{navy}",
   "bg-changed": "{amber-100}",
   "text-primary": "{ink-950}",
   "text-secondary": "{ink-800}",
   "text-placeholder": "{ink-700}",
   "text-brand": "{navy}",
   "text-link": "{blue-800}",
   "text-on-color": "{white}",
   "text-on-urgent": "{ink-950}",
   "text-success": "{green-800}",
   "text-warning": "{amber-800}",
   "text-danger": "{red-800}",
   "text-info": "{blue-800}",
   "action-primary": "{navy}",
   "action-primary-pressed": "{navy-pressed}",
   "action-secondary-border": "{navy}",
   "action-secondary-text": "{navy}",
   "action-secondary-pressed": "{ink-100}",
   "action-tonal": "{ink-100}",
   "action-tonal-text": "{navy}",
   "action-tonal-pressed": "{ink-200}",
   "action-destructive": "{red-700}",
   "action-destructive-pressed": "{red-800}",
   "action-disabled": "{ink-100}",
   "text-disabled": "{ink-600}",
   "border-divider": "{ink-200}",
   "border-tile": "{ink-200}",
   "border-input": "{ink-500}",
   "border-control": "{ink-600}",
   "border-selected": "{blue-700}",
   "border-focus": "{blue-700}",
   "border-error": "{red-700}",
   "icon-default": "{ink-800}",
   "icon-muted": "{ink-600}",
   "icon-brand": "{blue-700}",
   "icon-success": "{green-700}",
   "icon-warning": "{amber-600}",
   "icon-danger": "{red-700}",
   "icon-rating": "{amber-500}",
   "progress-fill": "{blue-700}",
   "progress-track": "{ink-200}",
   "tab-active": "{navy}",
   "tab-inactive": "{ink-700}",
   "status-calm-bg": "{ink-100}",
   "dot-waiting": "{amber-500}",
   "dot-active": "{blue-700}",
   "dot-done": "{green-700}",
   "dot-stopped": "{ink-600}",
   "dot-problem": "{red-700}",
   "status-warning-soft": "{amber-50}",
   "status-warning-border": "{amber-300}",
   "status-danger-soft": "{red-50}",
   "status-danger-border": "{red-300}",
   "status-success-soft": "{green-50}",
   "status-info-soft": "{blue-50}",
   "status-urgent-solid": "{amber-400}",
   "status-emergency-solid": "{red-700}"
  }
 },
 "type": {
  "base": 16,
  "ratio": 1.15,
  "scale": {
   "small": {
    "size": 14,
    "exact": 13.91,
    "multiplier": "16 x 1.15^-1",
    "lineHeight": 1.4,
    "lineHeightPx": 19.6,
    "weight": 500,
    "letterSpacing": "0em",
    "maxScale": 2.0,
    "use": "Timestamps, badge words (600), tab labels (600), helper lines. Never paragraphs."
   },
   "body": {
    "size": 16,
    "exact": 16.0,
    "multiplier": "16 x 1.15^0",
    "lineHeight": 1.5,
    "lineHeightPx": 24.0,
    "weight": 400,
    "letterSpacing": "0em",
    "maxScale": 2.0,
    "use": "All reading text, input values, list-row detail, chat."
   },
   "label": {
    "size": 16,
    "exact": 16.0,
    "multiplier": "16 x 1.15^0",
    "lineHeight": 1.5,
    "lineHeightPx": 24.0,
    "weight": 600,
    "letterSpacing": "0em",
    "maxScale": 2.0,
    "use": "Input labels, list-row titles, button labels (700 on buttons)."
   },
   "title": {
    "size": 18,
    "exact": 18.4,
    "multiplier": "16 x 1.15^1",
    "lineHeight": 1.35,
    "lineHeightPx": 24.3,
    "weight": 700,
    "letterSpacing": "-0.005em",
    "maxScale": 2.0,
    "use": "Card titles, the top-bar title, group headers."
   },
   "h3": {
    "size": 21,
    "exact": 21.16,
    "multiplier": "16 x 1.15^2",
    "lineHeight": 1.3,
    "lineHeightPx": 27.3,
    "weight": 700,
    "letterSpacing": "-0.01em",
    "maxScale": 1.8,
    "use": "Section titles, bottom-sheet titles."
   },
   "h2": {
    "size": 24,
    "exact": 24.33,
    "multiplier": "16 x 1.15^3",
    "lineHeight": 1.25,
    "lineHeightPx": 30.0,
    "weight": 700,
    "letterSpacing": "-0.015em",
    "maxScale": 1.6,
    "use": "Wizard questions, prices inside cards."
   },
   "h1": {
    "size": 28,
    "exact": 27.98,
    "multiplier": "16 x 1.15^4",
    "lineHeight": 1.2,
    "lineHeightPx": 33.6,
    "weight": 700,
    "letterSpacing": "-0.02em",
    "maxScale": 1.5,
    "use": "One screen title per screen."
   },
   "display": {
    "size": 32,
    "exact": 32.18,
    "multiplier": "16 x 1.15^5",
    "lineHeight": 1.15,
    "lineHeightPx": 36.8,
    "weight": 700,
    "letterSpacing": "-0.025em",
    "maxScale": 1.5,
    "use": "The one big number: the estimate total, \"You receive\"."
   }
  },
  "componentCaps": {
   "tab-label": 1.0,
   "unread-count": 1.0,
   "topbar-title": 1.5,
   "icon": 1.5
  },
  "exceptions": "Tab labels and unread counts are 14 (five tabs share a 360 phone); everything else is 15 or larger."
 },
 "space": {
  "space-4": 4,
  "space-8": 8,
  "space-12": 12,
  "space-16": 16,
  "space-20": 20,
  "space-24": 24,
  "space-32": 32,
  "space-40": 40,
  "space-48": 48,
  "space-64": 64
 },
 "radius": {
  "sm": 8,
  "md": 12,
  "lg": 16,
  "xl": 24,
  "pill": 999
 },
 "size": {
  "tap-min": 48,
  "button-lg": 56,
  "button-md": 48,
  "input": 56,
  "checkbox": 24,
  "avatar-sm": 32,
  "avatar-md": 40,
  "avatar-lg": 56,
  "icon-sm": 20,
  "icon-md": 24,
  "icon-lg": 28,
  "icon-tile": 40,
  "tabbar": 64,
  "topbar": 56,
  "topbar-android": 64
 }
}