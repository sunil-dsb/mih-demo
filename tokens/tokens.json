{
 "name": "MIH Pros",
 "version": "4.2",
 "font": {
  "family": "Inter",
  "fallback": [
   "SF Pro Text (iOS)",
   "Roboto (Android)"
  ],
  "weights": [
   400,
   500,
   600,
   700,
   800
  ],
  "numbers": "tabular-nums for money, times, counts"
 },
 "appearance": "light only (iOS UIUserInterfaceStyle=Light; Android Theme.Light + forceDarkAllowed=false)",
 "color": {
  "primitive": {
   "white": "#FFFFFF",
   "navy": "#14213D",
